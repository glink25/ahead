{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/glink25/ahead/raw/main/schemas/v0.1/schedule-timeline.json",
  "title": "ScheduleTimeline",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "value", "recordedAt"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 128 },
      "value": { "$ref": "temporal-value.json" },
      "recordedAt": { "type": "string", "format": "date-time" },
      "confidence": {
        "type": "string",
        "enum": ["confirmed", "likely", "rumored", "cancelled"]
      },
      "source": { "type": "string", "maxLength": 512 },
      "evidence": {
        "type": "array",
        "items": { "$ref": "evidence.json" },
        "maxItems": 32
      }
    }
  }
}
