# Auth Worker base URL (no trailing slash). Leave empty to hide OAuth button.
# Local: http://localhost:8787 with `pnpm dev:auth`
# Production Pages env: https://ahead-api.linkai.work
# Auth is only required for new OAuth logins and token refresh; restore uses IndexedDB.
VITE_AUTH_BASE_URL=http://localhost:8787

# Market Issues registry (owner/repo)
VITE_GITHUB_MARKET_REPOSITORY=glink25/ahead
