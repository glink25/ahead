{
  "name": "@ahead/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:offline": "AHEAD_OFFLINE_TEST=1 playwright test --config playwright.offline.config.ts"
  },
  "dependencies": {
    "@ahead/core": "workspace:*",
    "@ahead/editor": "workspace:*",
    "@ahead/github": "workspace:*",
    "@ahead/market": "workspace:*",
    "@ahead/protocol": "workspace:*",
    "@ahead/recommendation": "workspace:*",
    "@ahead/resolver": "workspace:*",
    "@ahead/schema": "workspace:*",
    "@ahead/sync": "workspace:*",
    "@ahead/ui": "workspace:*",
    "lucide-react": "^1.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0",
    "sonner": "^2.0.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
