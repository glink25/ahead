# GitHub App (User OAuth) Client ID / Secret — never commit real values.
# Create/manage at: https://github.com/settings/apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App slug used for installation divert:
# https://github.com/apps/{GITHUB_APP_SLUG}/installations/new
GITHUB_APP_SLUG=

# AES-GCM key material for OAuth state encryption
STATE_SECRET=

# Comma-separated frontend origins allowed for post-login redirect
# Append your production frontend Origin when self-hosting.
REDIRECT_URI_ALLOWLIST=http://localhost:4455

# Comma-separated browser Origins allowed for CORS (refresh endpoint)
# Append your production frontend Origin when self-hosting.
FRONTEND_ORIGIN=http://localhost:4455
