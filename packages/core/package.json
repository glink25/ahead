{
  "name": "@ahead/core",
  "version": "0.1.0",
  "description": "Ahead core authentication and repository contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
