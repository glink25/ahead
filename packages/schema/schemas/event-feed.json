{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/glink25/ahead/raw/main/schemas/v0.1/event-feed.json",
  "title": "EventFeed",
  "type": "object",
  "required": ["oefVersion", "kind", "id", "name"],
  "properties": {
    "oefVersion": { "const": "0.1" },
    "kind": { "const": "event-feed" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "name": { "$ref": "localized-text.json" },
    "description": { "$ref": "localized-text.json" },
    "primaryLanguage": { "type": "string", "minLength": 2, "maxLength": 16 },
    "tags": {
      "type": "array",
      "items": { "$ref": "tag.json" },
      "maxItems": 64
    },
    "events": {
      "type": "array",
      "items": { "$ref": "event.json" },
      "default": []
    },
    "eventsGlob": {
      "type": "string",
      "default": "events/**/*.yaml"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
