{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/glink25/ahead/raw/main/schemas/v0.1/patch.json",
  "title": "Patch",
  "type": "object",
  "required": ["eventId", "ops"],
  "additionalProperties": false,
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "additionalProperties": false,
        "properties": {
          "op": { "type": "string", "enum": ["set", "unset", "merge"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "value": true
        }
      }
    },
    "note": { "$ref": "localized-text.json" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
